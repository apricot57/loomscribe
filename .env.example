# LoomScribe Environment Configuration
PORT=3000

# Optional: Server-side API keys (can also be configured via Settings in the UI)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
# Login password to protect the UI (leave blank to disable auth)
APP_PASSWORD=

# Logging level: debug, info, warn, error (defaults to info)
LOG_LEVEL=info
